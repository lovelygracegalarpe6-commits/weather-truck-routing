# Copy to backend/.env for local development. Production sets these in the host's dashboard.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 if requests to the public APIs hang (IPv6 path that stalls TLS handshakes).
HTTP_FORCE_IPV4=0

# Domain tuning
# TRUCK_MAX_SPEED_MPH=65
# WIND_METRIC=sustained        # or "gust"
# HEATMAP_MAX_CELLS=220

# Point at your own instances if you outgrow the free public ones
# OSRM_BASE_URL=https://router.project-osrm.org
# PHOTON_BASE_URL=https://photon.komoot.io
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
